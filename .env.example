# Copy to .env and fill in. .env is gitignored — never commit the real key.
ELEVENLABS_API_KEY=sk_...
# Mission Control Live voices (ElevenLabs Voice Library -> copy each voice ID)
CAPCOM_VOICE_ID=
INTERN_VOICE_ID=
# Optional: the President's voice for the "Presidential visit" scene (defaults to the stock "Clyde" voice)
PRESIDENT_VOICE_ID=
# Live writing: Claude writes a fresh commentary for every click (web/api/script.js)
ANTHROPIC_API_KEY=
# Optional: LIVE_SCRIPT_MODEL (default claude-haiku-5-5), LIVE_SCRIPT_EFFORT (default low)
